# Copy to .env and fill in real values. NEVER commit .env (CLAUDE.md §10).

# --- Django ---
# DJANGO_SETTINGS_MODULE은 여기 두지 않는다. compose가 local을 직접 지정하고
# (docker-compose.yml), manage.py의 기본값도 local이다. 이 파일을 배포 환경변수로
# 옮기면 서버 진입점의 prod 기본값(fail closed)을 덮어써 개발 설정으로 뜬다
# (SPEC-006 TASK-005 보안 리뷰 M-3).
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=chamneul
POSTGRES_USER=chamneul
POSTGRES_PASSWORD=replace-with-a-local-password

# --- Google Cloud ---
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
# 아래 둘은 base.py에 기본값이 있어 없어도 동작하지만, "환경변수가 어떻게
# 로드되는가"(CLAUDE.md §11)를 설명하려면 전체 목록이 보여야 한다.
# REDIRECT_URI는 Google Cloud Console에 등록한 값과 정확히 일치해야 한다.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# 콜백 성공 후 브라우저가 최종 착지할 곳 (프론트 진입점, api.md #6).
GOOGLE_OAUTH_SUCCESS_REDIRECT=/
# 비밀번호 재설정 메일 속 링크의 앞부분 (api.md #45). 프론트 화면 주소.
# 실제 링크는 {이 값}#uid=...&token=... 형태다. prod에서는 반드시 https:// (빠뜨리면 localhost로 나간다 — S-6).
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Host perspective: talk to the compose-exposed Postgres port.
# Inside docker compose, the app service overrides these to DB_HOST=db / DB_PORT=5432.
DB_HOST=localhost
DB_PORT=15432
# 연결 재사용 시간(초). 0이면 요청마다 새 연결을 맺는다.
DB_CONN_MAX_AGE=60

# --- 운영(prod) 전용 — 로컬에서는 주석 그대로 둔다 ---
# 값을 여기서 미리 채워 두지 않는 이유: 이 파일이 그대로 배포 환경으로 복사되면
# 틀린 값이 조용히 통과한다. prod는 값이 빠지거나(프록시 수) 위험하면(메일) 기동을
# 거부하지만, 숫자가 배포 구성과 맞는지는 알 수 없다 — 배포 때 정해서 넣는다.
#
# 메일 백엔드. 비우면 SMTP. console·filebased는 재설정 링크를 서버(로그·디스크)에
# 남기므로 prod가 거부한다.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# 앱 앞에 있는 프록시 수 — 요청 횟수 제한의 클라이언트 IP 계산(api.md §1.10).
# 앞에 아무것도 없으면 0, ALB 하나 뒤면 1. prod는 필수(빠뜨리면 기동 거부).
# DRF_NUM_PROXIES=1
