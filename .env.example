# Copy to .env and fill in real values. NEVER commit .env (CLAUDE.md §10).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=chamneul
POSTGRES_USER=chamneul
POSTGRES_PASSWORD=replace-with-a-local-password

# --- Google Cloud ---
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
# 아래 둘은 base.py에 기본값이 있어 없어도 동작하지만, "환경변수가 어떻게
# 로드되는가"(CLAUDE.md §11)를 설명하려면 전체 목록이 보여야 한다.
# REDIRECT_URI는 Google Cloud Console에 등록한 값과 정확히 일치해야 한다.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# 콜백 성공 후 브라우저가 최종 착지할 곳 (프론트 진입점, api.md #6).
GOOGLE_OAUTH_SUCCESS_REDIRECT=/

# Host perspective: talk to the compose-exposed Postgres port.
# Inside docker compose, the app service overrides these to DB_HOST=db / DB_PORT=5432.
DB_HOST=localhost
DB_PORT=15432
# 연결 재사용 시간(초). 0이면 요청마다 새 연결을 맺는다.
DB_CONN_MAX_AGE=60
