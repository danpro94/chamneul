{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff format --check *)",
      "Bash(uv run python manage.py check *)",
      "Bash(uv run python manage.py check)",
      "Bash(uv run python manage.py makemigrations --check *)",
      "Bash(uv run python manage.py showmigrations *)",
      "Bash(uv run python manage.py showmigrations)",
      "Bash(uv run python manage.py sqlmigrate *)",
      "Bash(uv run python manage.py test *)",
      "Bash(uv run python manage.py test)",
      "Bash(docker compose ps *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose exec app python manage.py check *)",
      "Bash(docker compose exec app python manage.py check)",
      "Bash(docker compose exec app python manage.py makemigrations --check *)",
      "Bash(docker compose exec app python manage.py showmigrations *)",
      "Bash(docker compose exec app python manage.py showmigrations)",
      "Bash(docker compose exec app python manage.py sqlmigrate *)",
      "Bash(docker compose exec app python manage.py test *)",
      "Bash(curl -i http://localhost:8000/healthz)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(docs/_private/**)",
      "Edit(CLAUDE.md)",
      "Edit(Dockerfile)",
      "Edit(docker-compose.yml)",
      "Edit(docker-compose.override.yml)",
      "Edit(.env.example)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down -v)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/rules/00-source-of-truth.md",
            "timeout": 10,
            "statusMessage": "프로젝트 규칙 로드 중"
          }
        ]
      }
    ]
  }
}
